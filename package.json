{
  "name": "lex-agents",
  "version": "0.6.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "workspaces": [
    "apps/*",
    "infra/cdk"
  ],
  "scripts": {
    "dev": "pnpm --filter @lex-agents/web dev",
    "build": "pnpm --filter @lex-agents/web build",
    "lint": "pnpm --filter @lex-agents/web lint",
    "type-check": "pnpm --filter @lex-agents/web type-check",
    "test": "pnpm --filter @lex-agents/web test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,yaml,md}\""
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  },
  "pnpm": {
    "overrides": {
      "@typescript-eslint/parser": "^8.59.2",
      "@typescript-eslint/eslint-plugin": "^8.59.2"
    }
  }
}
