# ── Anthropic ─────────────────────────────────────────────────────────────────
# Required in prod; optional in dev (health check shows 'not_configured')
ANTHROPIC_API_KEY=sk-ant-...

# ── Qdrant ────────────────────────────────────────────────────────────────────
# URL of the Qdrant instance (use service name 'qdrant' inside Docker)
QDRANT_URL=http://qdrant:6333
# API key for Qdrant Cloud; leave empty for local/self-hosted
QDRANT_API_KEY=

# ── Application ───────────────────────────────────────────────────────────────
# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Runtime environment: dev | staging | prod
ENV=dev

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=lex-agents-api

# ── Security (Fase 5) ─────────────────────────────────────────────────────────
# JWT signing secret — placeholder, not enforced until Fase 5
JWT_SECRET=changeme-replace-in-prod

# ── Frontend → API ────────────────────────────────────────────────────────────
# URL used by the Next.js server to reach the API (inside Docker network)
API_BASE_URL=http://api:8000
# URL used by the browser to reach the API (localhost for local dev)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Langfuse observability ────────────────────────────────────────────────────
LANGFUSE_DB_PASSWORD=changeme
LANGFUSE_NEXTAUTH_SECRET=changeme-32-chars-nextauth-secret
LANGFUSE_SALT=changeme-32-chars-minimum-salt00
LANGFUSE_SECRET_KEY=changeme-32-chars-minimum-secret
LANGFUSE_PUBLIC_KEY=pk-lf-00000000-0000-0000-0000-000000000000
LANGFUSE_ADMIN_EMAIL=admin@lex-agents.local
LANGFUSE_ADMIN_PASSWORD=changeme-admin-pw
LANGFUSE_PORT=3003
LANGFUSE_HOST=http://langfuse-web:3000
# base64(LANGFUSE_PUBLIC_KEY:LANGFUSE_SECRET_KEY) — run: make langfuse-otlp-auth
LANGFUSE_OTLP_BASIC_AUTH=
