# ── Anthropic ─────────────────────────────────────────────────────────────────
# Required in prod; optional in dev (health check shows 'not_configured')
ANTHROPIC_API_KEY=sk-ant-...

# ── Qdrant ────────────────────────────────────────────────────────────────────
# URL of the Qdrant instance (use service name 'qdrant' inside Docker)
QDRANT_URL=http://qdrant:6333
# API key for Qdrant Cloud; leave empty for local/self-hosted
QDRANT_API_KEY=

# ── Application ───────────────────────────────────────────────────────────────
# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Runtime environment: dev | staging | prod
ENV=dev

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=lex-agents-api

# ── Security (Fase 5) ─────────────────────────────────────────────────────────
# JWT signing secret — placeholder, not enforced until Fase 5
JWT_SECRET=changeme-replace-in-prod

# ── Frontend → API ────────────────────────────────────────────────────────────
# URL used by the Next.js server to reach the API (inside Docker network)
API_BASE_URL=http://api:8000
# URL used by the browser to reach the API (localhost for local dev)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Fase 7.1 — New sources ────────────────────────────────────────────────────
# CENDOJ dev mode — institutional contact email for polite User-Agent (ADR 0025)
# Required when CENDOJ source is active; startup fails if missing in real mode
CENDOJ_CONTACT_EMAIL=

# INLABS (Diário Oficial da União, Brasil) — authentication token
# Required for InlabsDOUSource real mode; request at https://inlabs.in.gov.br/
INLABS_TOKEN=

# Commercial sources gate — set to 'true' only after signed license (ADR 0029)
# API will refuse to start if any commercial source is enabled without this flag
CONFIG_LICENSE_VERIFIED=false
