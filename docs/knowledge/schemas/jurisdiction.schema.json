{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Jurisdiction entry schema",
  "type": "object",
  "required": ["code", "name", "supervisor_prudential", "currency", "regime"],
  "properties": {
    "code": { "type": "string", "minLength": 2, "maxLength": 4 },
    "name": { "type": "string" },
    "supervisor_prudential": { "type": "string" },
    "supervisor_conduct": { "type": "string" },
    "supervisor_data": { "type": "string" },
    "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
    "regime": { "type": "string" },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
